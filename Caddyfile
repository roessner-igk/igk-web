:80 {
	root * /srv
	encode gzip zstd
	file_server
	redir /rohrtechnik /kabelschutzrohre permanent
	redir /rohrtechnik.html /kabelschutzrohre permanent
	redir /druckpruefung /din-en-1610 permanent
	redir /druckpruefung.html /din-en-1610 permanent
	redir /inspektion /dreh-schwenkkopf-kamera permanent
	redir /inspektion.html /dreh-schwenkkopf-kamera permanent
	redir /reinigung /sehende-duese permanent
	redir /reinigung.html /sehende-duese permanent
	redir /hochdruck /wasserhoechstdruckfraesen permanent
	redir /hochdruck.html /wasserhoechstdruckfraesen permanent
	header -Server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=2592000"
	try_files {path} {path}.html
	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
